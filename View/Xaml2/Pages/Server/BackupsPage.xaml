<Page x:Class="Fork.View.Xaml2.Pages.Server.BackupsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:converter="clr-namespace:Fork.View.Xaml.Converter"
      mc:Ignorable="d"
      Title="BackupsPage" d:DesignHeight="450" d:DesignWidth="800">
    <Page.Resources>
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converter:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converter:InvertBoolConverter x:Key="InvertBoolConverter" />
    </Page.Resources>
    <Grid Margin="0 0 20 0">
        <StackPanel Margin="40 25 40 0">
            <!-- Create Backup -->
            <TextBlock Text="Create Backup" Foreground="{DynamicResource textHeader}"
                       FontFamily="{DynamicResource Montserrat-SemiBold}" FontSize="23" />
            <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                <TextBlock Text="Name" VerticalAlignment="Center" FontSize="15"
                           FontFamily="{DynamicResource Montserrat-Medium}"
                           Foreground="{DynamicResource textUnselected}" Margin="0 0 10 0" />
                <Border CornerRadius="4" Width="220" Height="30"
                        Background="{DynamicResource textBackground}">
                    <TextBox Margin="5 0" Text="Backup" x:Name="createBackupName"
                             Background="{DynamicResource textBackground}" BorderThickness="0"
                             Foreground="{DynamicResource backgroundDark}"
                             FontFamily="{DynamicResource Montserrat-SemiBold}"
                             FontSize="15" VerticalAlignment="Center" />
                </Border>
                <Button x:Name="CreateBackupButton" Content="Create Backup" Click="CreateBackup_Click"
                        Style="{DynamicResource RoundedTextButton}" Margin="15 0 0 0"
                        IsEnabled="{Binding BackupInProgress, Converter={StaticResource InvertBoolConverter}}" />
            </StackPanel>
            <StackPanel Margin="0 12 0 0"
                        Visibility="{Binding BackupInProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressBar Style="{DynamicResource CustomProgressBar}" Height="14" Maximum="100"
                             Background="{DynamicResource textBackground}" BorderThickness="0"
                             Value="{Binding BackupProgress}" />
                <TextBlock Text="Creating backup..." Margin="0 5 0 0" FontSize="13"
                           FontFamily="{DynamicResource Montserrat-Medium}"
                           Foreground="{DynamicResource textUnselected}" />
            </StackPanel>
            <StackPanel Margin="0 12 0 0"
                        Visibility="{Binding RestoreInProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressBar Style="{DynamicResource CustomProgressBar}" Height="14" Maximum="100"
                             Background="{DynamicResource textBackground}" BorderThickness="0"
                             Value="{Binding RestoreProgress}" />
                <TextBlock Text="Restoring backup..." Margin="0 5 0 0" FontSize="13"
                           FontFamily="{DynamicResource Montserrat-Medium}"
                           Foreground="{DynamicResource textUnselected}" />
            </StackPanel>

            <!-- Backups -->
            <DockPanel Margin="0 40 0 0">
                <TextBlock Text="Open in File Explorer" DockPanel.Dock="Right" VerticalAlignment="Center"
                           PreviewMouseLeftButtonDown="OpenExplorer_PreviewMouseLeftButtonDown" Cursor="Hand"
                           Foreground="{DynamicResource textLink}" FontSize="13"
                           FontFamily="{DynamicResource Montserrat-Medium}" />
                <TextBlock Text="Backups" Foreground="{DynamicResource textHeader}"
                           FontFamily="{DynamicResource Montserrat-SemiBold}" FontSize="23" />
            </DockPanel>
            <TextBlock Text="The server must be stopped to restore a backup" Margin="0 5 0 0" FontSize="13"
                       FontFamily="{DynamicResource Montserrat-Medium}"
                       Foreground="{DynamicResource textUnselected}"
                       Visibility="{Binding ServerStopped, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            <ListView Margin="0 10 0 0" Background="Transparent"
                      Style="{DynamicResource SettingsListView}"
                      ItemsSource="{Binding Backups}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource foregroundDefault}" />
                        <Setter Property="Margin" Value="0 3 0 0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                    <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="8"
                                            Background="{TemplateBinding Background}">
                                        <Grid Height="60" Margin="10 0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0 0 20 0">
                                                <TextBlock x:Name="title" Text="{Binding Name}"
                                                           FontSize="16"
                                                           FontFamily="{DynamicResource Montserrat-SemiBold}"
                                                           Foreground="{DynamicResource textSelected}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Text="{Binding Created, StringFormat={}{0:g}}"
                                                        FontSize="12"
                                                        FontFamily="{DynamicResource Montserrat-Medium}"
                                                        Foreground="{DynamicResource textUnselected}" />
                                                    <TextBlock FontSize="12"
                                                               FontFamily="{DynamicResource Montserrat-Medium}"
                                                               Foreground="{DynamicResource textUnselected}"
                                                               Margin="8 0 0 0">
                                                        <Run Text="·" />
                                                        <Run Text="{Binding Size, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Restore" Click="RestoreBackup_Click"
                                                    Width="100" Style="{DynamicResource RoundedTextButton}"
                                                    Margin="0 0 10 0"
                                                    IsEnabled="{Binding DataContext.ServerStopped, RelativeSource={RelativeSource AncestorType=Page}}" />
                                            <Button Grid.Column="2" Content="Delete" Click="DeleteBackup_Click"
                                                    Width="100" Style="{DynamicResource RoundedTextButtonRed}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource backgroundHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </StackPanel>

        <!-- Restore confirmation dialog -->
        <Grid x:Name="RestoreDialogOverlay" Panel.ZIndex="10" Visibility="Collapsed">
            <Rectangle Fill="#1F2234" Opacity="0.9" />
            <Border Width="560" CornerRadius="10" Background="{DynamicResource backgroundDark}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Margin="25">
                    <TextBlock Text="Restore Backup" Foreground="{DynamicResource textHeader}"
                               FontFamily="{DynamicResource Montserrat-SemiBold}" FontSize="23" />
                    <TextBlock
                        Text="The server folder already contains files. Do you want to delete all existing files before restoring this backup?"
                        Foreground="{DynamicResource textDefault}"
                        FontFamily="{DynamicResource Montserrat-Medium}" FontSize="15"
                        TextWrapping="Wrap" Margin="0 15 0 0" />
                    <TextBlock Text="Deleting existing files can not be undone."
                               Foreground="{DynamicResource textUnselected}"
                               FontFamily="{DynamicResource Montserrat-Medium}" FontSize="13"
                               Margin="0 10 0 0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 25 0 0">
                        <Button Content="Cancel" Click="RestoreDialogCancel_Click"
                                Style="{DynamicResource TextButton}" />
                        <Button Content="Keep Existing Files" Click="RestoreDialogKeep_Click"
                                Style="{DynamicResource RoundedTextButton}" Margin="10 0 0 0" />
                        <Button Content="Delete Existing Files" Click="RestoreDialogDelete_Click"
                                Style="{DynamicResource RoundedTextButtonRed}" Margin="10 0 0 0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
